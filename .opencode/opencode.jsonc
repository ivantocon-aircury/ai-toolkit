{
  "$schema": "https://opencode.ai/config.json",

  "share": "disabled",
  "autoupdate": true,
  "snapshot": true,
  "formatter": true,
  "lsp": false,

  "model": "openai/gpt-5.6-terra",

  "instructions": [
    "~/.config/opencode/instructions/language.md",
    "~/.config/opencode/instructions/subagent-delegation.md",
    "~/.config/opencode/instructions/native-tools.md",
    ".opencode/instructions/worktrees.md"
  ],

  "compaction": {
    "auto": true,
    "prune": true
  },

  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/vendor/**",
      "**/var/**",
      "**/.next*/**",
      "**/.phpunit.cache/**",
      "**/.phpunit.result.cache",
      "**/playwright-report/**",
      "**/test-results/**",
      "**/coverage/**",
      "**/tsconfig.tsbuildinfo",
      "**/.idea/**"
    ]
  },

  "agent": {
    "executor": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "variant": "low",
      "description": "Execute commands and analyze their output. Never edit files.",
      "prompt": "Execute shell commands only. Never edit files. For repository inspection, use the native read, list, glob, and grep tools instead of Bash. Use Bash only when a native tool cannot perform the task. Do not use Python or other scripting languages unless the task explicitly requires them. If the project uses Docker or Docker Compose, execute PHP, Composer, Symfony, Node, npm, pnpm, yarn, tests, linters, type checks and build commands inside the appropriate container. Prefer existing project wrappers such as Make targets when they already encapsulate Docker. Before running tooling commands, inspect the project setup if necessary using native read-only tools. Run the minimum number of commands required. Keep output concise and summarize failures, warnings, stack traces and actionable next steps. Avoid printing large logs unless explicitly requested.",
      "permission": {
        "edit": "deny"
      }
    },

    "search": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "variant": "medium",
      "description": "Search the codebase efficiently. Never edit files.",
      "prompt": "Search the project using the native glob, grep, list, and read tools. Do not use Bash for repository inspection unless a native tool cannot perform the task. Never edit files. Prefer targeted searches over opening many files. Return only relevant files, symbols, usages, implementations and concise summaries. Include line numbers when helpful. Never dump entire files unless explicitly requested.",
      "permission": {
        "edit": "deny"
      }
    }
  },

  "permission": {
    // Native tools: read-only project work that does not need a shell.
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",

    // OpenCode session utilities with no OS-level side effects.
    "todowrite": "allow",
    "skill": "allow",

    "bash": {
      // All shell commands require approval unless explicitly listed below.
      "*": "ask",

      // Safe, argument-free shell inspection.
      "pwd": "allow",
      "ls": "allow",
      "du": "allow",
      "df": "allow",
      "whoami": "allow",
      "id": "allow",
      "uname": "allow",
      "date": "allow",

      // Safe, argument-free Git inspection.
      "git status": "allow",
      "git diff": "allow",
      "git remote": "allow",
      "git tag": "allow",
      "git branch": "allow",

      // Safe, argument-free Docker inspection.
      "docker ps": "allow",
      "docker compose ps": "allow",
      "docker compose images": "allow",
      "docker compose version": "allow",

      // Shell bookkeeping with no filesystem or process effects.
      "true": "allow",
      "exit": "allow",

      // Argument-bearing commands that should always be reviewed.
      "git branch *": "ask",
      "git fetch *": "ask",
      "git pull *": "ask",
      "git checkout *": "ask",
      "git switch *": "ask",
      "make *": "ask",

      // File output must be reviewed; never allow suppressed diagnostics.
      "* > *": "ask",
      "* >> *": "ask",
      "*>*": "ask",
      "*2>/dev/null*": "deny",
      "*2> /dev/null*": "deny",
      "*>/dev/null*": "deny",
      "*> /dev/null*": "deny",

      // Never run host language tooling; use a reviewed container command instead.
      "php *": "deny",
      "composer *": "deny",
      "symfony *": "deny",
      "node *": "deny",
      "npm *": "deny",
      "npx *": "deny",
      "pnpm *": "deny",
      "yarn *": "deny",

      // Destructive or history-changing Git operations.
      "git merge *": "deny",
      "git rebase *": "deny",
      "git reset *": "deny",
      "git clean *": "deny",
      "awk *": "deny",

      // Destructive or publishing Docker operations.
      "docker compose push *": "deny",
      "docker system prune *": "deny",

      // System-wide or irreversible host operations.
      "printenv *": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny"
    },
    "external_directory": {
      // Ask before accessing paths outside the current project.
      "*": "ask",

      // Never access Windows mounts or credential/configuration directories.
      "/mnt/c/**": "deny",
      "/mnt/d/**": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/opencode/**": "deny"
    }
  },

  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@4.0.3"
      ]
    }
  }
}
