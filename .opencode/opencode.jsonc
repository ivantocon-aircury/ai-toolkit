{
  "$schema": "https://opencode.ai/config.json",

  "share": "disabled",
  "snapshot": true,
  "formatter": true,
  "lsp": false,

  "model": "openai/gpt-5.5",
  "small_model": "openai/gpt-5.4-mini",

  "instructions": [
    ".opencode/instructions/language.md",
    ".opencode/instructions/subagent-delegation.md"
  ],

  "compaction": {
    "auto": true,
    "prune": true
  },

  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/vendor/**",
      "**/var/**",
      "**/.next*/**",
      "**/.phpunit.cache/**",
      "**/.phpunit.result.cache",
      "**/playwright-report/**",
      "**/test-results/**",
      "**/coverage/**",
      "**/tsconfig.tsbuildinfo",
      "**/.idea/**"
    ]
  },

  "agent": {
    "executor": {
      "mode": "subagent",
      "model": "openai/gpt-5.4-mini",
      "description": "Execute commands and analyze their output. Never edit files.",
      "prompt": "Execute shell commands only. Never edit files. If the project uses Docker or Docker Compose, execute PHP, Composer, Symfony, Node, npm, pnpm, yarn, tests, linters, type checks and build commands inside the appropriate container. Prefer existing project wrappers such as Make targets when they already encapsulate Docker. Before running tooling commands, inspect the project setup if necessary using read-only commands. Run the minimum number of commands required. Keep output concise and summarize failures, warnings, stack traces and actionable next steps. Avoid printing large logs unless explicitly requested.",
      "permission": {
        "edit": "deny"
      }
    },

    "search": {
      "mode": "subagent",
      "model": "openai/gpt-5.4-mini",
      "description": "Search the codebase efficiently. Never edit files.",
      "prompt": "Search the project using fast search tools such as rg, grep, find or git grep. Never edit files. Prefer targeted searches over opening many files. Return only relevant files, symbols, usages, implementations and concise summaries. Include line numbers when helpful. Never dump entire files unless explicitly requested.",
      "permission": {
        "edit": "deny"
      }
    }
  },

  "permission": {
    "bash": {
      "*": "ask",

      "pwd*": "allow",
      "ls*": "allow",
      "tree*": "allow",
      "cat*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "grep*": "allow",
      "rg*": "allow",
      "find*": "allow",
      "wc*": "allow",
      "sort*": "allow",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git grep*": "allow",
      "git fetch*": "allow",

      "docker ps*": "allow",
      "docker compose ps*": "allow",
      "docker compose config*": "allow",
      "docker compose images*": "allow",
      "docker compose top*": "allow",
      "docker compose port*": "allow",
      "docker compose version*": "allow",
      "docker compose logs*": "allow",
      "docker compose exec*": "allow",
      "docker compose run*": "allow",

      "make*": "ask",

      "php*": "deny",
      "composer*": "deny",
      "symfony*": "deny",
      "node*": "deny",
      "npm*": "deny",
      "pnpm*": "deny",
      "yarn*": "deny",

      "git push*": "deny",
      "git pull*": "ask",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git checkout*": "ask",
      "git switch*": "ask",

      "docker compose push*": "deny",
      "docker system prune*": "deny",

      "rm -rf*": "deny",
      "sudo*": "deny"
    }
  },

  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    }
  }
}
