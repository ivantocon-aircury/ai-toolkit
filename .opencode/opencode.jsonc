{
  "$schema": "https://opencode.ai/config.json",

  "share": "disabled",
  "snapshot": true,
  "formatter": true,
  "lsp": false,

  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "xhigh"
          }
        }
      }
    }
  },

  "model": "openai/gpt-5.6-luna",

  "instructions": [
    "~/.config/opencode/instructions/language.md",
    "~/.config/opencode/instructions/subagent-delegation.md"
  ],

  "compaction": {
    "auto": true,
    "prune": true
  },

  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/vendor/**",
      "**/var/**",
      "**/.next*/**",
      "**/.phpunit.cache/**",
      "**/.phpunit.result.cache",
      "**/playwright-report/**",
      "**/test-results/**",
      "**/coverage/**",
      "**/tsconfig.tsbuildinfo",
      "**/.idea/**"
    ]
  },

  "agent": {
    "executor": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "variant": "low",
      "description": "Execute commands and analyze their output. Never edit files.",
      "prompt": "Execute shell commands only. Never edit files. For reading project files, prefer native shell utilities (cat, head, tail, sed, grep, rg) instead of invoking Python or other scripting languages unless the task explicitly requires them. If the project uses Docker or Docker Compose, execute PHP, Composer, Symfony, Node, npm, pnpm, yarn, tests, linters, type checks and build commands inside the appropriate container. Prefer existing project wrappers such as Make targets when they already encapsulate Docker. Before running tooling commands, inspect the project setup if necessary using read-only commands. Run the minimum number of commands required. Keep output concise and summarize failures, warnings, stack traces and actionable next steps. Avoid printing large logs unless explicitly requested.",
      "permission": {
        "edit": "deny"
      }
    },

    "search": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "variant": "xhigh",
      "description": "Search the codebase efficiently. Never edit files.",
      "prompt": "Search the project using fast search tools such as rg, grep, find or git grep. Never edit files. Prefer targeted searches over opening many files. Return only relevant files, symbols, usages, implementations and concise summaries. Include line numbers when helpful. Never dump entire files unless explicitly requested.",
      "permission": {
        "edit": "deny"
      }
    }
  },

  "permission": {
    "bash": {
      "*": "ask",

      "pwd *": "allow",
      "printf *": "allow",

      "ls *": "allow",
      "tree *": "allow",

      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "sed -n *": "allow",

      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",

      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "diff *": "allow",

      "stat *": "allow",
      "file *": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "dirname *": "allow",
      "basename *": "allow",

      "du *": "allow",
      "df *": "allow",

      "which *": "allow",
      "whereis *": "allow",
      "type *": "allow",
      "command -v *": "allow",

      "whoami *": "allow",
      "id *": "allow",
      "uname *": "allow",
      "date *": "allow",
      "printenv *": "allow",

      "sha256sum *": "allow",
      "sha1sum *": "allow",
      "md5sum *": "allow",

      "jq *": "allow",

      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git grep *": "allow",

      "git rev-parse *": "allow",
      "git ls-files *": "allow",
      "git ls-tree *": "allow",
      "git cat-file *": "allow",
      "git describe *": "allow",

      "git remote *": "allow",
      "git tag *": "allow",

      "git branch": "allow",
      "git branch --show-current": "allow",
      "git branch --list *": "allow",
      "git branch --contains *": "allow",
      "git branch --merged *": "allow",
      "git branch --no-merged *": "allow",
      "git branch -a *": "allow",
      "git branch -r *": "allow",
      "git branch -v *": "allow",
      "git branch -vv *": "allow",

      "docker ps *": "allow",

      "docker compose ps *": "allow",
      "docker compose config *": "allow",
      "docker compose images *": "allow",
      "docker compose top *": "allow",
      "docker compose port *": "allow",
      "docker compose version *": "allow",
      "docker compose logs *": "allow",

      "tree * -o *": "ask",
      "tree * --output *": "ask",
      "tree * --output=*": "ask",

      "sort * -o *": "ask",
      "sort * --output *": "ask",
      "sort * --output=*": "ask",

      "find * -delete *": "ask",
      "find * -exec *": "ask",
      "find * -execdir *": "ask",
      "find * -ok *": "ask",
      "find * -okdir *": "ask",

      "git diff * --output *": "ask",
      "git diff * --output=*": "ask",
      "git log * --output *": "ask",
      "git log * --output=*": "ask",
      "git show * --output *": "ask",
      "git show * --output=*": "ask",

      "docker compose config * --output *": "ask",
      "docker compose config * --output=*": "ask",

      "* > *": "ask",
      "* >> *": "ask",
      "*>*": "ask",

      "git branch *": "ask",
      "git fetch *": "ask",
      "git pull *": "ask",
      "git checkout *": "ask",
      "git switch *": "ask",

      "docker compose exec *": "allow",
      "docker compose run *": "allow",
      "make *": "ask",

      "php *": "deny",
      "composer *": "deny",
      "symfony *": "deny",
      "node *": "deny",
      "npm *": "deny",
      "npx *": "deny",
      "pnpm *": "deny",
      "yarn *": "deny",

      "git push *": "deny",
      "git merge *": "deny",
      "git rebase *": "deny",
      "git reset *": "deny",
      "git clean *": "deny",

      "docker compose push *": "deny",
      "docker system prune *": "deny",

      "rm -rf *": "deny",
      "sudo *": "deny"
    }
  },

  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    }
  }
}
