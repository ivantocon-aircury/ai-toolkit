{
  "$schema": "https://opencode.ai/config.json",

  "share": "disabled",
  "snapshot": true,
  "formatter": true,
  "lsp": false,

  "model": "openai/gpt-5.5",
  "small_model": "openai/gpt-5.4-mini",

  "instructions": [
    ".opencode/instructions/executor-agent.md"
  ],

  "compaction": {
    "auto": true,
    "prune": true
  },

  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/vendor/**",
      "**/var/**",
      "**/.next*/**",
      "**/.phpunit.cache/**",
      "**/.phpunit.result.cache",
      "**/playwright-report/**",
      "**/test-results/**",
      "**/coverage/**",
      "**/tsconfig.tsbuildinfo",
      "**/.idea/**"
    ]
  },

  "agent": {
    "executor": {
      "mode": "subagent",
      "model": "openai/gpt-5.4-mini",
      "description": "Use this agent for shell commands, Docker commands, tests, linters, type checks, builds and command-output analysis. It does not edit files.",
      "prompt": "Execute shell commands and summarize results concisely. Do not edit files. Prefer safe, read-only commands unless verification requires execution. Use the minimum useful output. Focus on test failures, linting issues, stack traces and actionable fixes only.",
      "permission": {
        "edit": "deny"
      }
    }
  },

  "permission": {
    "bash": {
      "*": "ask",

      "ls*": "allow",
      "cat*": "allow",
      "grep*": "allow",
      "rg*": "allow",
      "find*": "allow",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",

      "docker ps*": "allow",
      "docker compose ps*": "allow",
      "docker compose config*": "allow",
      "docker compose images*": "allow",
      "docker compose top*": "allow",
      "docker compose port*": "allow",
      "docker compose version*": "allow",
      "docker compose logs*": "allow",
      "docker compose exec*": "allow",
      "docker compose run*": "allow",

      "git push*": "deny",
      "git rebase*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",

      "docker compose push*": "deny",
      "docker system prune*": "deny",

      "rm -rf*": "deny",
      "sudo*": "deny"
    }
  },

  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    }
  }
}
