{
  "$schema": "https://opencode.ai/config.json",

  "share": "disabled",
  "autoupdate": true,
  "snapshot": true,
  "formatter": true,
  "lsp": false,

  "model": "openai/gpt-5.6-terra",

  "instructions": [
    "~/.config/opencode/instructions/language.md",
    "~/.config/opencode/instructions/development.md",
    "~/.config/opencode/instructions/subagent-delegation.md"
  ],

  "compaction": {
    "auto": true,
    "prune": true
  },

  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/vendor/**",
      "**/var/**",
      "**/.next*/**",
      "**/.phpunit.cache/**",
      "**/.phpunit.result.cache",
      "**/playwright-report/**",
      "**/test-results/**",
      "**/coverage/**",
      "**/tsconfig.tsbuildinfo",
      "**/.idea/**"
    ]
  },

  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "ask",
      "**/.env*": "ask"
    },
    "edit": {
      "*": "allow",
      "**/.env": "ask",
      "**/.env*": "ask"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "doom_loop": "allow",
    "skill": "allow",

    "bash": {
      "*": "allow",
      "git reset --hard *": "deny",
      "git reset --hard": "deny",
      "git clean *": "deny",
      "docker system prune *": "deny",
      "docker system prune": "deny",
      "rm -rf *": "deny",
      "rm -rf": "deny",
      "cat .env": "deny",
      "cat .env*": "deny",
      "source .env": "deny",
      "source .env*": "deny",
      "env": "deny",
      "printenv": "deny",
      "printenv *": "deny",
      "set": "deny",
      "sudo *": "deny"
    },

    "external_directory": {
      // Ask before accessing paths outside the current project.
      "*": "ask",

      // Task worktrees use the shared development worktree root.
      "~/work/worktrees/**": "allow",

      // Secrets require explicit approval even within the development workspace.
      "~/work/**/.env": "ask",
      "~/work/**/.env*": "ask",

      // Never access Windows mounts or credential/configuration directories.
      "/mnt/c/**": "deny",
      "/mnt/d/**": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/opencode/**": "deny"
    }
  },

  "plugin": ["opencode-wakatime"],

  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@4.0.3"
      ]
    }
  }
}
