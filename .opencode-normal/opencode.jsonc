{
  "$schema": "https://opencode.ai/config.json",

  "share": "disabled",
  "autoupdate": true,
  "snapshot": true,
  "formatter": true,
  "lsp": false,

  "model": "openai/gpt-5.6-terra",

  "instructions": [
    "~/.config/opencode/instructions/language.md",
    "~/.config/opencode/instructions/development.md",
    "~/.config/opencode/instructions/subagent-delegation.md"
  ],

  "compaction": {
    "auto": true,
    "prune": true
  },

  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/vendor/**",
      "**/var/**",
      "**/.next*/**",
      "**/.phpunit.cache/**",
      "**/.phpunit.result.cache",
      "**/playwright-report/**",
      "**/test-results/**",
      "**/coverage/**",
      "**/tsconfig.tsbuildinfo",
      "**/.idea/**"
    ]
  },

  "permission": {
    // Native tools: read-only project work that does not need a shell.
    "read": {
      "*": "allow",
      "**/.env": "ask",
      "**/.env*": "ask"
    },
    "edit": {
      "*": "ask",
      "**/.env": "deny",
      "**/.env*": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",

    // OpenCode session utilities with no OS-level side effects.
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "task": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "context7_resolve-library-id": "ask",
    "context7_query-docs": "ask",

    "bash": {
      // All shell commands require approval unless explicitly listed below.
      "*": "ask",

      // Safe, argument-free shell inspection.
      "pwd": "allow",
      "ls": "allow",
      "du": "allow",
      "df": "allow",
      "whoami": "allow",
      "id": "allow",
      "uname": "allow",
      "date": "allow",

      // Safe, argument-free Git inspection.
      "git status": "allow",
      "git diff": "allow",
      "git remote": "allow",
      "git tag": "allow",
      "git branch": "allow",

      // Safe, argument-free Docker inspection.
      "docker ps": "allow",
      "docker compose ps": "allow",
      "docker compose images": "allow",
      "docker compose version": "allow",

      // Shell bookkeeping with no filesystem or process effects.
      "true": "allow",
      "exit": "allow",

      // Argument-bearing commands that should always be reviewed.
      "git branch *": "ask",
      "git fetch *": "ask",
      "git pull *": "ask",
      "git checkout *": "ask",
      "git switch *": "ask",
      "make *": "ask",

      // File output must be reviewed; never allow suppressed diagnostics.
      "* > *": "ask",
      "* >> *": "ask",
      "*>*": "ask",
      "*2>/dev/null*": "deny",
      "*2> /dev/null*": "deny",
      "*>/dev/null*": "deny",
      "*> /dev/null*": "deny",

      // Host language tooling always requires explicit review.
      "php *": "ask",
      "composer *": "ask",
      "symfony *": "ask",
      "node *": "ask",
      "npm *": "ask",
      "npx *": "ask",
      "pnpm *": "ask",
      "yarn *": "ask",

      // Destructive or history-changing Git operations.
      "git merge *": "ask",
      "git rebase *": "ask",
      "git reset *": "deny",
      "git clean *": "deny",
      "awk *": "deny",

      // Destructive or publishing Docker operations.
      "docker compose push *": "deny",
      "docker system prune *": "deny",

      // System-wide or irreversible host operations.
      "env": "deny",
      "printenv": "deny",
      "printenv *": "deny",
      "set": "deny",
      "rm -rf *": "deny",
      "rm -rf": "deny",
      "sudo *": "deny"
    },
    "external_directory": {
      // Ask before accessing paths outside the current project.
      "*": "ask",

      // Never access Windows mounts or credential/configuration directories.
      "/mnt/c/**": "deny",
      "/mnt/d/**": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/opencode/**": "deny"
    }
  },

  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@4.0.3"
      ]
    }
  }
}
